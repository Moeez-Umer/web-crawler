{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "CrawlerDb": "Host=localhost;Port=5432;Database=crawlerdb;Username=crawler;Password=crawler_pass"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "crawler",
    "Password": "crawler_pass",
    "MaxAttempts": 5,
    "RetryDelayMs": 2000,
    "PrefetchCount": 10
  },
  "Worker": {
    "MaxPages": 200
  },
  "urls": "http://+:5001"
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CrawlerDb": "Host=localhost;Port=5432;Database=crawlerdb;Username=crawler;Password=crawler_pass"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "crawler",
    "Password": "crawler_pass",
    "MaxAttempts": 5,
    "RetryDelayMs": 2000,
    "PrefetchCount": 10
  },
  "Crawler": {
    "MaxPages": 200,
    "UserAgent": "WebCrawler/1.0 (+https://your-domain.example/contact; set Crawler:UserAgent)",
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "urls": "http://+:5000"
}

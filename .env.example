# PostgreSQL container & connection settings
POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawler_pass
POSTGRES_DB=crawlerdb
CRAWLER_DB_CONNECTION=Host=postgres;Port=5432;Database=crawlerdb;Username=crawler;Password=crawler_pass

# RabbitMQ container & connection settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=crawler
RABBITMQ_PASS=crawler_pass

# Worker & retry settings
CRAWLER_MAX_ATTEMPTS=5
CRAWLER_RETRY_DELAY_MS=2000
CRAWLER_PREFETCH_COUNT=10
CRAWLER_MAX_PAGES=200
CRAWLER_USER_AGENT="WebCrawler/1.0 (+https://your-domain.example/contact; set Crawler:UserAgent)"

# API & Frontend ports / CORS
# Override API_PORT if port 5000 conflicts on your host
API_PORT=5000
FRONTEND_PORT=5173
CRAWLER_ALLOWED_ORIGIN=http://localhost:5173

# Integration test PostgreSQL connection string (used when running `dotnet test` on the host)
CRAWLER_TEST_DB=Host=localhost;Port=5432;Database=crawlerdb;Username=crawler;Password=crawler_pass

